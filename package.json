{
  "name": "gzw-data-api",
  "version": "4.6.0",
  "private": true,
  "description": "GZW Data API â€” Gray Zone Warfare game data. Auto-discovered endpoints from /data JSON files.",
  "scripts": {
    "start": "node api/index.js",
    "dev": "node --watch api/index.js",
    "dev:server": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "snapshot:record": "node scripts/record-snapshot.js",
    "lint": "eslint api/ lib/ scripts/ tests/ playwright.config.js",
    "validate:data": "node scripts/validate-data.js",
    "stamp": "node scripts/stamp-assets.js",
    "test:security": "playwright test",
    "test:security:api": "playwright test --project=http",
    "test:security:browser": "playwright test --project=chromium --project=firefox",
    "test:security:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "gray-zone-warfare",
    "gaming",
    "api",
    "game-data",
    "vercel"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.13.0"
  }
}
