{
  "name": "gzw-data-api",
  "version": "4.6.0",
  "private": true,
  "description": "GZW Data API \u00e2\u20ac\u201d Gray Zone Warfare game data. Auto-discovered endpoints from /data JSON files.",
  "scripts": {
    "start": "node api/index.js",
    "dev": "node --watch api/index.js",
    "dev:server": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "snapshot:record": "node scripts/record-snapshot.js",
    "lint": "eslint api/ lib/ scripts/ tests/",
    "validate:data": "node scripts/validate-data.js",
    "stamp": "node scripts/stamp-assets.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "gray-zone-warfare",
    "gaming",
    "api",
    "game-data",
    "vercel"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.12.0"
  }
}
