{
  "name": "gzw-data-api",
  "version": "4.0.0",
  "private": true,
  "description": "GZW Data API — Gray Zone Warfare game data. Auto-discovered endpoints from /data JSON files.",
  "scripts": {
    "start": "node api/index.js",
    "dev": "node --watch api/index.js",
    "test": "node --test tests/*.test.js",
    "snapshot:record": "node scripts/record-snapshot.js",
    "lint": "eslint api/ lib/ scripts/ tests/",
    "validate:data": "node scripts/validate-data.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "gray-zone-warfare",
    "gaming",
    "api",
    "game-data",
    "vercel"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.9.1"
  }
}
