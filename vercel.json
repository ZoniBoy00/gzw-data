{
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://registry.npmjs.org https://pypi.org; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/datasets",
      "destination": "/datasets/",
      "permanent": true
    },
    {
      "source": "/datasets/:name",
      "destination": "/datasets/:name/",
      "permanent": true
    },
    {
      "source": "/querying",
      "destination": "/querying/",
      "permanent": true
    },
    {
      "source": "/records",
      "destination": "/records/",
      "permanent": true
    },
    {
      "source": "/responses",
      "destination": "/responses/",
      "permanent": true
    },
    {
      "source": "/limits",
      "destination": "/limits/",
      "permanent": true
    },
    {
      "source": "/docs/examples",
      "destination": "/docs/examples/",
      "permanent": true
    },
    {
      "source": "/clients",
      "destination": "/clients/",
      "permanent": true
    },
    {
      "source": "/docs/sdk",
      "destination": "/docs/sdk/",
      "permanent": true
    },
    {
      "source": "/docs/python",
      "destination": "/docs/python/",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/playground/",
      "permanent": true
    },
    {
      "source": "/explorer",
      "destination": "/explorer/",
      "permanent": true
    },
    {
      "source": "/status",
      "destination": "/status/",
      "permanent": true
    },
    {
      "source": "/data-sources",
      "destination": "/data-sources/",
      "permanent": true
    },
    {
      "source": "/feedback",
      "destination": "/feedback/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service/",
      "permanent": true
    },
    {
      "source": "/legal/privacy-policy",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/legal/privacy-policy/",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/legal/terms-of-service",
      "destination": "/terms-of-service/",
      "permanent": true
    },
    {
      "source": "/legal/terms-of-service/",
      "destination": "/terms-of-service/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/web/assets/$1"
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "/web/.well-known/security.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/web/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/web/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/web/llms.txt"
    },
    {
      "source": "/agents.json",
      "destination": "/web/agents.json"
    },
    {
      "source": "/pricing.json",
      "destination": "/web/pricing.json"
    },
    {
      "source": "/docs/",
      "destination": "/web/docs/index.html"
    },
    {
      "source": "/datasets/",
      "destination": "/web/datasets/index.html"
    },
    {
      "source": "/datasets/:name/",
      "destination": "/web/dataset/index.html"
    },
    {
      "source": "/querying/",
      "destination": "/web/querying/index.html"
    },
    {
      "source": "/records/",
      "destination": "/web/records/index.html"
    },
    {
      "source": "/responses/",
      "destination": "/web/responses/index.html"
    },
    {
      "source": "/limits/",
      "destination": "/web/limits/index.html"
    },
    {
      "source": "/docs/examples/",
      "destination": "/web/docs/examples/index.html"
    },
    {
      "source": "/clients/",
      "destination": "/web/clients/index.html"
    },
    {
      "source": "/docs/sdk/",
      "destination": "/web/docs/sdk/index.html"
    },
    {
      "source": "/docs/python/",
      "destination": "/web/docs/python/index.html"
    },
    {
      "source": "/playground/",
      "destination": "/web/playground/index.html"
    },
    {
      "source": "/explorer/",
      "destination": "/web/explorer/index.html"
    },
    {
      "source": "/status/",
      "destination": "/web/status/index.html"
    },
    {
      "source": "/data-sources/",
      "destination": "/web/data-sources/index.html"
    },
    {
      "source": "/feedback/",
      "destination": "/web/feedback/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/web/privacy-policy/index.html"
    },
    {
      "source": "/terms-of-service/",
      "destination": "/web/terms-of-service/index.html"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    }
  ]
}
