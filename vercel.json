{
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "/web/assets/$1" },
    { "source": "/privacy-policy", "destination": "/web/legal/privacy-policy/index.html" },
    { "source": "/privacy-policy/", "destination": "/web/legal/privacy-policy/index.html" },
    { "source": "/terms-of-service", "destination": "/web/legal/terms-of-service/index.html" },
    { "source": "/terms-of-service/", "destination": "/web/legal/terms-of-service/index.html" },
    { "source": "/.well-known/security.txt", "destination": "/web/.well-known/security.txt" },
    { "source": "/docs", "destination": "/web/docs/index.html" },
    { "source": "/docs/", "destination": "/web/docs/index.html" },
    { "source": "/404.html", "destination": "/web/404.html" },
    { "source": "/robots.txt", "destination": "/web/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/web/sitemap.xml" },
    { "source": "/llms.txt", "destination": "/web/llms.txt" },
    { "source": "/agents.json", "destination": "/web/agents.json" },
    { "source": "/pricing.json", "destination": "/web/pricing.json" },
    { "source": "/", "destination": "/web/index.html" }
  ]
}
